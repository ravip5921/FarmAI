# Root-owned, shell-compatible configuration read by deploy-release.sh.
# Install as /etc/farmai/deploy.env with mode 0644.

FARMAI_SOURCE_REPO=/home/ravi/apps/FarmAI
FARMAI_DEPLOY_BASE=/home/ravi/apps/farmai
FARMAI_APP_ENV_FILE=/etc/farmai/farmai.env
FARMAI_PYTHON_COMMAND=python3.11
FARMAI_NVM_DIR=/home/ravi/.nvm
FARMAI_NODE_VERSION=22

FARMAI_API_SERVICE=farmai-api.service
FARMAI_WORKER_SERVICE=farmai-worker.service
FARMAI_API_URL=http://127.0.0.1:8000
FARMAI_SMOKE_PORT=18080

# An active analysis is allowed to finish for up to one hour. Increase this
# above the worst-case document processing time; never shorten it to force a
# worker restart in the middle of an external AI call.
FARMAI_DRAIN_TIMEOUT_SECONDS=3600
FARMAI_DRAIN_STATUS_GRACE_SECONDS=15
FARMAI_WORKER_STATUS_MAX_AGE_SECONDS=30
FARMAI_HTTP_ATTEMPTS=30
FARMAI_HTTP_DELAY_SECONDS=2
