# Application environment shared by the API, worker, migrations, and smoke
# tests. Install as /etc/farmai/farmai.env with mode 0640 and restrict the file
# to the service account. Keep values shell-compatible: quote spaces and shell
# metacharacters. Do not commit real credentials.

FARMAI_UI_RUNTIME_DIR=/home/ravi/apps/farmai/shared/runtime
FARMAI_UI_ALLOWED_ORIGINS=https://farmai.cht77.com
FARMAI_UI_MAX_UPLOAD_BYTES=52428800

# Uncomment and fill these only when the LLM engine is used.
# FARMAI_LLM_API_URL=https://example.invalid/api/chat
# FARMAI_LLM_MODEL=model-name
# FARMAI_LLM_TIMEOUT_SECONDS=120
