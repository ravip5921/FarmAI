[Unit]
Description=FarmAI FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ravi
Group=ravi
WorkingDirectory=/home/ravi/apps/farmai/current
EnvironmentFile=/etc/farmai/farmai.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ravi/apps/farmai/current/.venv/bin/python -m uvicorn user_interface.backend.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0027

[Install]
WantedBy=multi-user.target
